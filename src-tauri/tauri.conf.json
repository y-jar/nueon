{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nueon",
  "version": "26.10.11",
  "identifier": "io.nueon.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nueon",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 y-jar",
    "icon": [
      "icons/128x128.png",
      "icons/icon.png",
      "icons/64x64.png",
      "icons/48x48.png",
      "icons/32x32.png"
    ]
  }
}
